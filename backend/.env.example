# Smart Farm DSS — Backend Environment Variables
# ─────────────────────────────────────────────
# Copy this file:  cp backend/.env.example backend/.env
# (Or run the setup script from the project root: npm run setup)
#
# The shared Atlas cluster URL is pre-filled — no local MongoDB needed.

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3001
UPLOAD_DIR=uploads

# Shared MongoDB Atlas cluster — works for everyone on the team out of the box.
DATABASE_URL=mongodb+srv://dubeyaadarsh637_db_user:qdTL1iwrs1vnNdc8@smart-farm-cluster.zebw8fp.mongodb.net/smart_farm?retryWrites=true&w=majority&appName=smart-farm-cluster

# Fine to leave as-is for local development.
JWT_SECRET=dev-only-secret-please-change-in-production-32chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

