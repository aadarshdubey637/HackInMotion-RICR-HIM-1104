# Smart Farm DSS — Environment Variables
# Copy to backend/.env and fill in.
#
# Only DATABASE_URL and JWT_SECRET are required. Every third-party key below
# is optional: the app degrades one feature gracefully rather than failing.

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3001
UPLOAD_DIR=uploads

# ============================================
# DATABASE (required)
# ============================================
# Local MongoDB:
DATABASE_URL=mongodb://localhost:27017/smart_farm
# MongoDB Atlas:
# DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/smart_farm?retryWrites=true&w=majority

# ============================================
# AUTHENTICATION (required)
# ============================================
# Must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ============================================
# WEATHER — no key needed
# ============================================
# The irrigation & risk engine runs on Open-Meteo, which requires no API key
# and no credit card. Nothing to configure here.
#
# Optional: OpenWeatherMap as a secondary provider.
# OPENWEATHER_API_KEY=

# ============================================
# CROP HEALTH (optional upgrade)
# ============================================
# Without this key the built-in rule-based diagnostic engine is used.
# With it, Plant.id image analysis runs first and the rule engine becomes
# the fallback. https://plant.id/
# PLANT_ID_API_KEY=

# ============================================
# MARKET PRICES (optional upgrade)
# ============================================
# Free instant key from https://data.gov.in/ for live AGMARKNET mandi prices.
# Without it, the app serves its seeded price history.
# DATA_GOV_IN_API_KEY=
