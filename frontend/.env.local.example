# Frontend environment. Copy to `frontend/.env.local` (gitignored).
#
# Both values are safe to expose — anything prefixed NEXT_PUBLIC_ is compiled
# into the browser bundle by design.

# Where the API lives. Defaults to http://localhost:3001/api when unset, so for
# local development you can leave this out entirely.
# NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Google Sign-In client id — the SAME value as GOOGLE_CLIENT_ID in backend/.env.
# The backend verifies tokens against it; the browser requests tokens with it.
# Unset hides the "Continue with Google" button; email sign-in is unaffected.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
