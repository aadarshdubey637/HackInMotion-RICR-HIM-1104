# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
# Local:      postgresql://postgres:postgres@localhost:5432/smart_farm
# Render/Neon: use the connection string they give you
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_farm

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Weather (Open-Meteo needs no key, kept here in case you swap providers)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Market price data (data.gov.in Agmarknet — request a free key at https://data.gov.in)
MARKET_API_KEY=
MARKET_API_BASE_URL=https://api.data.gov.in/resource

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
