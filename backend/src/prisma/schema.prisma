// Smart Farm Decision Support System — Data Model
//
// Provider: MongoDB (via Prisma). Chosen for schema flexibility on the
// JSON-heavy fields (weather payloads, analysis results, agronomy metadata)
// and zero-setup hosting on Atlas.
//
// Notes for MongoDB provider:
//  - Ids are ObjectId, mapped to the reserved `_id` field.
//  - `Decimal` is unsupported on MongoDB — monetary/measurement values use Float.
//  - Geospatial columns (PostGIS Point/Polygon) are unsupported — farm location
//    is stored as plain latitude/longitude Floats, with an optional GeoJSON
//    `boundary` blob for map rendering. No PostGIS dependency.
//  - Referential actions run in Prisma's emulated mode (relationMode = "prisma"
//    is implicit for MongoDB), so `onDelete` is honoured by the client, not the DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum UserRole {
  FARMER
  ADVISOR
  ADMIN
}

enum FarmStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CropStatus {
  PLANNED
  PLANTED
  GROWING
  FLOWERING
  FRUITING
  HARVESTED
  FAILED
  FALLOW
}

enum GrowthStage {
  SEED
  GERMINATION
  VEGETATIVE
  FLOWERING
  FRUIT_SET
  RIPENING
  HARVEST_READY
}

enum SoilType {
  SANDY
  LOAMY
  CLAY
  SILTY
  PEATY
  CHALKY
  MIXED
}

enum IrrigationMethod {
  DRIP
  SPRINKLER
  FLOOD
  FURROW
  SUBSURFACE
  MANUAL
  RAINFED
}

enum AlertType {
  WEATHER_RISK
  IRRIGATION_NEEDED
  DISEASE_DETECTED
  PEST_DETECTED
  NUTRIENT_DEFICIENCY
  HARVEST_WINDOW
  PRICE_OPPORTUNITY
  FROST_WARNING
  HEAT_STRESS
  FLOOD_RISK
  DROUGHT_RISK
}

enum AlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HealthObservationType {
  DISEASE
  PEST
  NUTRIENT
  GROWTH
  WEATHER_DAMAGE
  OTHER
}

enum HealthSeverity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum HealthStatus {
  ACTIVE
  MONITORING
  TREATED
  RESOLVED
}

// ─────────────────────────────── Models ──────────────────────────────

model User {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  email String @unique

  /// Null for accounts created through Google Sign-In, which never set a
  /// password. Every password path must treat null as "this account does not
  /// sign in that way" rather than assuming a hash is present.
  passwordHash String? @map("password_hash")

  /// Google's stable subject id (`sub`) for the account. Matched on before
  /// email, because a Google user may later change the address on their
  /// Google account and `sub` is the only identifier guaranteed not to move.
  ///
  /// Indexed but deliberately NOT `@unique`. MongoDB treats a missing field as
  /// null for indexing, so a unique index here rejects the *second* password-only
  /// account — every one of them has no google_id, and the index sees a pile of
  /// duplicate nulls (E11000). Sparse indexes fix that but Prisma cannot declare
  /// one. Uniqueness is not lost: one Google account has one email, and `email`
  /// above is unique, so two rows can never share a google_id.
  googleId String? @map("google_id")

  /// A second way to sign in besides the email address. Stored lowercased — a
  /// farmer should not have to remember capitalisation to get back into their
  /// own account.
  ///
  /// No longer collected: registration asks for name, Gmail, mobile and a
  /// password only, and Google Sign-In never set one either, so every account
  /// created from now on has null here. The field stays because accounts that
  /// predate the change still hold a username and `login` still accepts it as an
  /// identifier — dropping it would lock those farmers out of the credential
  /// they have been typing.
  ///
  /// Optional and deliberately NOT `@unique`, for exactly the reason documented
  /// on `googleId` above: MongoDB indexes a *missing* field as null, so a unique
  /// index here would reject the second account that has no username — and
  /// every account created through Google Sign-In has none. Uniqueness is
  /// enforced in application code before insert (`assertIdentifiersAreFree` in
  /// auth.service.ts). See PRE-DEPLOY note at the bottom of this file for the
  /// sparse index that closes the remaining race window.
  username String?

  name String

  /// Mobile number in E.164 form (`+919876543210`), collected at registration.
  /// Null on accounts created through Google Sign-In, which never ask for one.
  /// Same nullable-unique situation as `username`: indexed, checked in code.
  phone String?

  language    String    @default("en")
  role        UserRole  @default(FARMER)
  avatarUrl   String?   @map("avatar_url")
  preferences Json?
  isVerified  Boolean   @default(false) @map("is_verified")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  farms          Farm[]
  sessions       Session[]
  emailOtps      EmailOtp[]
  passwordResets PasswordReset[]

  @@index([googleId])
  @@index([username])
  @@index([phone])
  @@map("users")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A one-time code emailed to a farmer to prove they own their Gmail address.
///
/// Only password accounts ever get one. Google Sign-In accounts arrive already
/// verified — Google asserted the address — so `loginWithGoogle` sets
/// `isVerified` directly and never issues a code.
///
/// Rows are kept after use rather than deleted: `consumedAt` is what makes a
/// code single-use, and the spent rows are also what the per-hour send limit in
/// `email-otp.ts` counts. `cleanupExpiredOtps` clears the old ones.
model EmailOtp {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId

  /// bcrypt hash of the six digits — never the digits themselves.
  ///
  /// A six-digit code is only a million possibilities, so a leaked database
  /// dump would give up plaintext codes instantly to anything faster. bcrypt at
  /// BCRYPT_ROUNDS makes that search cost hours instead of milliseconds, and by
  /// then every code in the table is long expired. It is the same hash the
  /// account password uses, for the same reason.
  codeHash String @map("code_hash")

  /// Ten minutes after issue. Short on purpose: the farmer has the mail open.
  expiresAt DateTime @map("expires_at")

  /// Wrong guesses against this code. At the limit the code is dead and a new
  /// one must be requested — that cap, not the hash, is what stops an online
  /// brute force of a six-digit space.
  attempts Int @default(0)

  /// Set the moment the code is accepted. Non-null means spent: re-sending the
  /// same digits a second time must not verify the account again.
  ///
  /// MongoDB trap, verified by experiment. Prisma does not write an optional
  /// field it was not given, so a row created without this one has no
  /// `consumed_at` key at all — and `where: { consumedAt: null }` does NOT match
  /// a missing key, even though MongoDB's own `$eq: null` would. Querying it the
  /// obvious way makes every emailed code unfindable and verification reject
  /// correct codes as expired. Always go through `NOT_CONSUMED` in email-otp.ts,
  /// which accepts both shapes.
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The lookup every verify does: newest live code for one farmer.
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_otps")
}

/// A one-time code emailed to a farmer who has forgotten their password.
///
/// Kept in its own collection rather than sharing `EmailOtp` with a `purpose`
/// discriminator. The two codes must never be interchangeable — a code emailed
/// to confirm an address must not also be able to set a new password — and a
/// separate collection makes that structural instead of dependent on every
/// query remembering to filter. It also avoids retrofitting a field onto the
/// `email_otps` documents already in the database, where a missing key and a
/// null one are not the same thing to a MongoDB query (see `consumedAt` above).
///
/// Rows survive being used, for the same two reasons `EmailOtp` rows do:
/// `consumedAt` is what makes a code single-use, and the spent rows are what the
/// per-hour send limit counts. `cleanupExpiredPasswordResets` clears old ones.
model PasswordReset {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId

  /// bcrypt hash of the six digits — never the digits themselves. This code is
  /// worth more than a verification code (it grants the account), so hashing it
  /// matters more here, not less.
  codeHash String @map("code_hash")

  /// Fifteen minutes after issue. Slightly longer than the verification code:
  /// a farmer resetting a password often has to go and find the phone the mail
  /// arrived on, where one verifying an address is already holding it.
  expiresAt DateTime @map("expires_at")

  /// Wrong guesses against this code. At the limit the code is dead — that cap
  /// is what stops an online brute force of a six-digit space.
  attempts Int @default(0)

  /// Set the moment the password is actually changed. Non-null means spent, so
  /// the same code cannot be replayed to set a second password later.
  ///
  /// Same MongoDB trap as `EmailOtp.consumedAt`: `where: { consumedAt: null }`
  /// does not match a document that never had the key written. Always query
  /// through `NOT_CONSUMED` in password-reset.ts, which accepts both shapes.
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The lookup every reset does: newest live code for one farmer.
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_resets")
}

model Farm {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId
  name   String

  // Location. Plain lat/lon replaces the PostGIS Point — this is what the
  // weather provider needs, and it keeps the stack free of a spatial extension.
  latitude  Float
  longitude Float
  address   String?

  // Optional GeoJSON polygon for drawing the farm outline on a map.
  // Stored as an opaque document; never queried spatially.
  boundary Json?

  totalAreaHectares Float      @map("total_area_hectares")
  soilTypePrimary   SoilType?  @map("soil_type_primary")
  soilAnalysis      Json?      @map("soil_analysis")
  status            FarmStatus @default(ACTIVE)
  metadata          Json?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcels          Parcel[]
  crops            Crop[]
  weatherData      WeatherData[]
  healthLogs       HealthLog[]
  alerts           Alert[]
  recommendations  Recommendation[]
  yieldPredictions YieldPredictionLog[]

  @@index([userId])
  @@index([status])
  @@map("farms")
}

/// An optional subdivision of a farm (a field / plot). Farms work fine with
/// zero parcels — crops may attach directly to the farm.
model Parcel {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  farmId         String    @map("farm_id") @db.ObjectId
  name           String
  boundary       Json?
  areaHectares   Float     @map("area_hectares")
  soilType       SoilType?
  soilProperties Json?     @map("soil_properties")
  irrigationZone String?   @map("irrigation_zone")
  microclimate   Json?
  displayOrder   Int       @default(0) @map("display_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  farm           Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crops          Crop[]
  soilData       SoilData[]
  weatherData    WeatherData[]
  irrigationLogs IrrigationLog[]
  healthLogs     HealthLog[]

  @@index([farmId])
  @@map("parcels")
}

model Crop {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  farmId              String       @map("farm_id") @db.ObjectId
  parcelId            String?      @map("parcel_id") @db.ObjectId
  cropName            String       @map("crop_name")
  varietyId           String?      @map("variety_id") @db.ObjectId
  plantingDate        DateTime?    @map("planting_date")
  expectedHarvestDate DateTime?    @map("expected_harvest_date")
  growthStage         GrowthStage? @map("growth_stage")
  status              CropStatus   @default(PLANNED)
  managementPlan      Json?        @map("management_plan")
  expectedYieldKg     Float?       @map("expected_yield_kg")
  actualYieldKg       Float?       @map("actual_yield_kg")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  farm    Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  parcel  Parcel?      @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  variety CropVariety? @relation(fields: [varietyId], references: [id], onDelete: SetNull)

  weatherData      WeatherData[]
  irrigationLogs   IrrigationLog[]
  healthLogs       HealthLog[]
  priceHistory     PriceHistory[]
  alerts           Alert[]
  yieldPredictions YieldPredictionLog[]

  @@index([farmId])
  @@index([parcelId])
  @@index([status])
  @@index([cropName])
  @@map("crops")
}

/// Agronomy reference data — seeded, not user-editable.
/// Drives water requirements, planting windows and suitability scoring.
model CropVariety {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  cropName            String   @map("crop_name")
  varietyName         String   @map("variety_name")
  climateRequirements Json     @map("climate_requirements")
  soilRequirements    Json     @map("soil_requirements")
  growingDays         Int      @map("growing_days")
  waterRequirementMm  Float    @map("water_requirement_mm")
  diseaseResistance   Json     @map("disease_resistance")
  marketInfo          Json     @map("market_info")
  plantingWindows     Json     @map("planting_windows")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  crops Crop[]

  @@unique([cropName, varietyName])
  @@index([cropName])
  @@map("crop_varieties")
}

model WeatherData {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  farmId         String   @map("farm_id") @db.ObjectId
  parcelId       String?  @map("parcel_id") @db.ObjectId
  cropId         String?  @map("crop_id") @db.ObjectId
  recordedAt     DateTime @map("recorded_at")
  temperatureMin Float?   @map("temperature_min")
  temperatureMax Float?   @map("temperature_max")
  temperatureAvg Float?   @map("temperature_avg")
  humidity       Float?
  rainfall       Float?
  windSpeed      Float?   @map("wind_speed")
  solarRadiation Float?   @map("solar_radiation")
  soilMoisture   Float?   @map("soil_moisture")
  et0            Float?
  rawData        Json?    @map("raw_data")
  createdAt      DateTime @default(now()) @map("created_at")

  farm   Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  parcel Parcel? @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  crop   Crop?   @relation(fields: [cropId], references: [id], onDelete: SetNull)

  // One weather row per farm per timestamp — lets the fetcher upsert
  // idempotently instead of relying on createMany+skipDuplicates,
  // which MongoDB does not support.
  @@unique([farmId, recordedAt])
  @@index([parcelId, recordedAt])
  @@index([recordedAt])
  @@map("weather_data")
}

model SoilData {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  parcelId       String   @map("parcel_id") @db.ObjectId
  sampledAt      DateTime @map("sampled_at")
  ph             Float?
  nitrogen       Float?
  phosphorus     Float?
  potassium      Float?
  organicCarbon  Float?   @map("organic_carbon")
  textureClass   String?  @map("texture_class")
  bulkDensity    Float?   @map("bulk_density")
  micronutrients Json?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now()) @map("created_at")

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@map("soil_data")
}

model IrrigationLog {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  cropId           String           @map("crop_id") @db.ObjectId
  parcelId         String?          @map("parcel_id") @db.ObjectId
  irrigatedAt      DateTime         @map("irrigated_at")
  waterAmountMm    Float            @map("water_amount_mm")
  irrigationMethod IrrigationMethod @map("irrigation_method")
  guidanceSource   String           @map("guidance_source")
  wasRecommended   Boolean          @default(false) @map("was_recommended")
  weatherContext   Json?            @map("weather_context")
  createdAt        DateTime         @default(now()) @map("created_at")

  crop   Crop    @relation(fields: [cropId], references: [id], onDelete: Cascade)
  parcel Parcel? @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@index([cropId, irrigatedAt])
  @@index([parcelId, irrigatedAt])
  @@map("irrigation_logs")
}

model HealthLog {
  id                 String                @id @default(auto()) @map("_id") @db.ObjectId
  farmId             String                @map("farm_id") @db.ObjectId
  cropId             String                @map("crop_id") @db.ObjectId
  parcelId           String?               @map("parcel_id") @db.ObjectId
  observedAt         DateTime              @map("observed_at")
  observationType    HealthObservationType @map("observation_type")
  description        String
  imageUrl           String?               @map("image_url")
  analysisResult     Json?                 @map("analysis_result")
  diseaseDetected    String?               @map("disease_detected")
  pestDetected       String?               @map("pest_detected")
  severity           HealthSeverity
  status             HealthStatus          @default(ACTIVE)
  recommendedActions Json?                 @map("recommended_actions")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  farm   Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop   Crop    @relation(fields: [cropId], references: [id], onDelete: Cascade)
  parcel Parcel? @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@index([cropId, observedAt])
  @@index([farmId, observedAt])
  @@index([parcelId, observedAt])
  @@index([status])
  @@map("health_logs")
}

model PriceHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  cropId       String?  @map("crop_id") @db.ObjectId
  commodity    String
  priceDate    DateTime @map("price_date")
  minPrice     Float    @map("min_price")
  maxPrice     Float    @map("max_price")
  modalPrice   Float    @map("modal_price")
  marketName   String   @map("market_name")
  state        String
  district     String
  unit         String
  qualityGrade String?  @map("quality_grade")
  source       String   @default("agmarknet")
  createdAt    DateTime @default(now()) @map("created_at")

  crop Crop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  // Keyed on commodity rather than cropId so national price series can be
  // ingested once and shared across every farmer growing that commodity.
  @@unique([commodity, priceDate, marketName, unit])
  @@index([commodity, priceDate])
  @@index([cropId, priceDate])
  @@index([priceDate])
  @@map("price_history")
}

model Alert {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  farmId      String        @map("farm_id") @db.ObjectId
  parcelId    String?       @map("parcel_id") @db.ObjectId
  cropId      String?       @map("crop_id") @db.ObjectId
  alertType   AlertType     @map("alert_type")
  severity    AlertSeverity
  message     String
  metadata    Json?
  isRead      Boolean       @default(false) @map("is_read")
  isDismissed Boolean       @default(false) @map("is_dismissed")
  createdAt   DateTime      @default(now()) @map("created_at")
  expiresAt   DateTime?     @map("expires_at")

  // Stable natural key for a generated alert, e.g. "<farmId>:HEAT_STRESS:2026-08-13".
  // Lets the engine re-run on every refresh without duplicating alerts.
  dedupeKey String @unique @map("dedupe_key")

  farm Farm  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop Crop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([farmId, createdAt])
  @@index([farmId, isRead])
  @@index([severity])
  @@index([alertType])
  @@map("alerts")
}

model Recommendation {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  farmId           String   @map("farm_id") @db.ObjectId
  cropName         String   @map("crop_name")
  varietyName      String   @map("variety_name")
  suitabilityScore Float    @map("suitability_score")
  climateScore     Float    @map("climate_score")
  soilScore        Float    @map("soil_score")
  marketScore      Float    @map("market_score")
  waterScore       Float    @map("water_score")
  reasoning        Json?
  expectedOutcomes Json?    @map("expected_outcomes")
  season           String
  createdAt        DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, createdAt])
  @@index([farmId, season])
  @@map("recommendations")
}

/// A stored run of the yield engine.
///
/// The engine itself is stateless — it recomputes on every request. Keeping each
/// run means a farmer can see how the estimate *moved*: a figure that climbed
/// after they started irrigating, or fell when blast was found, argues for the
/// advice far better than a single number ever does. It also lets the estimate
/// be checked against `Crop.actualYieldKg` once the crop is in.
///
/// Named `YieldPredictionLog` rather than `YieldPrediction` because the engine
/// already exports a type by that name (`modules/planning/yield.ts`), and having
/// two different things called the same in one file is a trap. Follows the same
/// convention as `HealthLog`, which is likewise a stored computed result.
model YieldPredictionLog {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  farmId String @map("farm_id") @db.ObjectId
  cropId String @map("crop_id") @db.ObjectId

  predictedAt DateTime @default(now()) @map("predicted_at")

  predictedTotalKg Float @map("predicted_total_kg")
  predictedKgHa    Float @map("predicted_kg_ha")
  rangeLowKg       Float @map("range_low_kg")
  rangeHighKg      Float @map("range_high_kg")
  areaHectares     Float @map("area_hectares")

  /// 0-1. Rises as the season progresses and more real data accumulates.
  confidence     Float
  /// 0-1 fraction of the growing season elapsed when this run was made.
  seasonProgress Float  @map("season_progress")
  /// Gross income at the price of the day, if a price was available.
  estimatedIncome Float? @map("estimated_income")

  /// The stress factors, snapshotted so an old run stays explainable after the
  /// weather and health records behind it have rolled on.
  factors Json

  createdAt DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop Crop @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([cropId, predictedAt])
  @@index([farmId, predictedAt])
  @@map("yield_prediction_logs")
}

// ───────────────────── AFTER EVERY db push: sparse indexes ─────────────────────
//
// `User.username` and `User.phone` are unique to a farmer, but Prisma cannot
// declare the *sparse* unique index MongoDB needs for a nullable field (see the
// note on `username`). Application code checks both before every insert, which
// leaves a race window of a few milliseconds: two farmers submitting the same
// username at the same instant could both pass the check.
//
// Closing it is `npm run db:indexes` (src/prisma/apply-sparse-indexes.ts), and it
// must run AFTER every `prisma db push` — not once. Push syncs indexes to exactly
// what this schema declares, and it *drops* anything else it finds, logging the
// removal as `[-] Unique index users_username_sparse_unique`. Verified, not
