# Dependencies
node_modules/
.pnp
.pnp.js

# Environment — never commit real credentials
.env
.env.local
.env.*.local
# Editor and hand-made backups of a .env hold exactly the same secrets as the
# original, and are easy to create by accident while rotating a key.
.env.bak
*.env.bak
.env.save
!.env.example

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Prisma generated client
**/generated/

# Local MongoDB replica-set data directory
.mongodb/

# Uploaded crop photos (user content, not source)
backend/uploads/
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

