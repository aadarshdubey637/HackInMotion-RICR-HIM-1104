# Smart Farm DSS — Environment Variables
# ──────────────────────────────────────────
# 1. Copy this file:   cp .env.example backend/.env
# 2. That's it for the database — the shared Atlas cluster is pre-filled below.
# 3. JWT_SECRET is safe to leave as-is for local development.
#
# Only DATABASE_URL and JWT_SECRET are required.
# Every third-party key is optional — the app degrades gracefully without them.

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3001
UPLOAD_DIR=uploads

# ============================================
# DATABASE
# Shared MongoDB Atlas cluster for the team.
# No local MongoDB installation needed.
# Everyone on the team uses this same URL.
# ============================================
DATABASE_URL=mongodb+srv://dubeyaadarsh637_db_user:qdTL1iwrs1vnNdc8@smart-farm-cluster.zebw8fp.mongodb.net/smart_farm?retryWrites=true&w=majority&appName=smart-farm-cluster

# ============================================
# AUTHENTICATION
# ============================================
# Fine to leave as-is for local development.
# Change this to a long random string in production.
JWT_SECRET=dev-only-secret-please-change-in-production-32chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ============================================
# WEATHER — no key needed
# ============================================
# Open-Meteo is used for weather/irrigation — no API key, no credit card.
# Optional: OpenWeatherMap as a secondary provider.
# OPENWEATHER_API_KEY=

# ============================================
# CROP HEALTH (optional)
# ============================================
# Without this key the built-in rule-based engine is used (works fine).
# With it, Plant.id image analysis runs first. https://plant.id/
# PLANT_ID_API_KEY=

# ============================================
# MARKET PRICES (optional)
# ============================================
# Free key from https://data.gov.in/ for live AGMARKNET mandi prices.
# Without it the app uses seeded price history.
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001e82c90863980456369c95a94a5511eaa

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
