# Compose variables for docker/docker-compose.yml
#
#   cp docker/.env.example docker/.env
#
# Then replace every REPLACE_ value below. Compose reads this file
# automatically when it sits next to the compose file, and refuses to start
# while any required variable is still unset.
#
# docker/.env is git-ignored. Do not commit real values.

# ── Required ────────────────────────────────────────────────────────────

# MongoDB root credentials. Used both to create the user inside the container
# and to build the backend's DATABASE_URL, so the two cannot drift apart.
MONGO_ROOT_USER=smartfarm
MONGO_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Signs every access and refresh token. Minimum 32 characters — the backend
# validates the length at boot and exits if it is shorter.
#
# Generate one:  openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS

# ── Optional ────────────────────────────────────────────────────────────
# Each of these degrades one feature when unset; none stops the app booting.

# Live AGMARKNET mandi prices. Free key: https://data.gov.in/
DATA_GOV_IN_API_KEY=

# Crop photo analysis fallback. Without it the rule-based engine is used.
PLANT_ID_API_KEY=

# "Continue with Google". Unset hides the button.
GOOGLE_CLIENT_ID=

# Email OTP delivery. EMAIL_APP_PASSWORD is a 16-character Google App
# Password, not the account password.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# ── URLs ────────────────────────────────────────────────────────────────
# Override when running anywhere other than a local machine.
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api
