# Smart Farm DSS — Environment Variables
# ──────────────────────────────────────
# Copy this file:  cp .env.example backend/.env
# Ask a teammate for the DATABASE_URL connection string.
# Only DATABASE_URL and JWT_SECRET are required to run the app.

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3001
UPLOAD_DIR=uploads

# ============================================
# DATABASE (required)
# Ask a teammate for the shared Atlas URL, or use local MongoDB.
# See README.md → "Database" section for setup instructions.
# ============================================
DATABASE_URL=<ask a teammate>

# ============================================
# AUTHENTICATION (required)
# Fine to leave as-is for local development.
# ============================================
JWT_SECRET=dev-only-secret-please-change-in-production-32chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ============================================
# WEATHER — no key needed
# Open-Meteo is used for weather/irrigation. No API key required.
# ============================================
# OPENWEATHER_API_KEY=

# ============================================
# CROP HEALTH (optional)
# Without this key the built-in rule-based engine is used.
# ============================================
# PLANT_ID_API_KEY=

# ============================================
# MARKET PRICES (optional)
# Free key from https://data.gov.in/
# ============================================
# DATA_GOV_IN_API_KEY=

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
