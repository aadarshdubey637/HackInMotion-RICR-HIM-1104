# Smart Farm DSS — Backend Environment Variables
# ─────────────────────────────────────────────
# Copy this file:  cp backend/.env.example backend/.env
# Then fill in the values marked <required>.
# Ask a teammate for the DATABASE_URL connection string.

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3001
UPLOAD_DIR=uploads

# MongoDB connection string — ask a teammate for the shared Atlas URL,
# or use a local replica set (see README.md for setup).
DATABASE_URL=<ask a teammate>

# JWT — fine to leave as-is for local development.
JWT_SECRET=dev-only-secret-please-change-in-production-32chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Optional — the app works without these.
# DATA_GOV_IN_API_KEY=
# PLANT_ID_API_KEY=
# OPENWEATHER_API_KEY=

# Google Sign-In (optional). Only the client id is needed — the browser obtains
# the ID token and the backend verifies it, so there is no client *secret*.
# Must be the SAME value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in frontend/.env.local.
# Unset simply means the "Continue with Google" button is not offered;
# username/email + password sign-in is unaffected.
# GOOGLE_CLIENT_ID=

# Email OTP delivery via Gmail SMTP (optional — unset disables OTP email).
# EMAIL_APP_PASSWORD is a Google App Password, NOT your Gmail password:
# generate a 16-character one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Store it without the spaces Google displays.
# EMAIL_USER=your-account@gmail.com
# EMAIL_APP_PASSWORD=abcdefghijklmnop
